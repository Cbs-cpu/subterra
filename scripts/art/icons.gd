static func build(template: String, pal: String) -> ImageTexture:
	var c := Pix.new(12, 12)
	var rows: Array = T.get(template, T["piedra"])
	var legend := {
		"1": Pix.ramp(pal, 0), "2": Pix.ramp(pal, 1), "3": Pix.ramp(pal, 2), "4": Pix.ramp(pal, 3),
		"h": Pix.ramp("madera", 2), "H": Pix.ramp("madera", 1), "w": Color("#f4f4f8"), "k": Color("#2a2232"),
		"r": Pix.ramp(pal, 3) if pal in ["fuego", "hielo", "rayo", "ceniza", "vida", "mana", "esmeralda", "gelatina", "laser"] else Color("#e0304a"),
	}
	# Pociones: el líquido usa la rampa de la poción; el vidrio es claro.
	c.stamp(rows, 0, 0, legend)
	c.outline()
	return c.tex()
